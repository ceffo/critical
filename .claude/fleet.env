# Fleet configuration, read by every fleet command (.claude/bin/fleet) and by the hooks.
# An environment variable of the same name wins over this file. Everything has a default; uncomment what differs.

# Tracker backend: github (Issues; native sub-issues and dependencies), linear, jira or beads (local `br` store).
FLEET_TRACKER=linear

# --- Linear only ---
LINEAR_TEAM=CRI                  # the team key (required for linear)
LINEAR_PROJECT="critical-hit"      # optional: scopes the tracker to this project of the team: new issues are filed in it, and ready/list/questions only see its issues
# The API key: export LINEAR_API_KEY, or write it to ~/.config/agents-dev-fleet/linear-api-key (chmod 600).
# Linear team setting: set "When PR opened" to In Review (Settings > Team > Workflows & automations > Pull request and commit
# automations); its default moves the issue back to In Progress right after fleet ship moves it to In Review.

# --- Jira only (the `jira` CLI, ankitpokhrel/jira-cli: `jira init`, token in JIRA_API_TOKEN; the fleet handles no token) ---
#JIRA_PROJECT=OD                  # the project key (required for jira); ids are keys like OD-123
# Fleet state -> the project's workflow status name (moves go through the CLI's transitions):
#JIRA_STATE_TODO="To Do"          #   defaults: To Do / In Progress / In Review / Backlog / Done
#JIRA_STATE_IN_PROGRESS="In Progress"
#JIRA_STATE_IN_REVIEW="In Review"
#JIRA_STATE_BACKLOG=Backlog
#JIRA_STATE_DONE=Done
# Fleet priority -> Jira priority name:
#JIRA_PRIORITY_URGENT=Highest     #   defaults: Highest / High / Medium / Low; None sets no priority
#JIRA_PRIORITY_HIGH=High
#JIRA_PRIORITY_MEDIUM=Medium
#JIRA_PRIORITY_LOW=Low
#JIRA_PRIORITY_NONE=              #   a name to use when `update --priority None` must set one (e.g. Lowest)
#JIRA_TYPE_EPIC=Epic              # issue type of an item created with --label epic (default Epic)
#JIRA_TYPE_ITEM=Task              # issue type of every other item (default Task)
#JIRA_BLOCKS_LINK=Blocks          # the issue-link type for blocked-by (default Blocks)
#JIRA_EFFORT_FIELD=story-points   # optional: the jira CLI's custom-field name for --effort
#JIRA_EFFORT_FIELD_ID=customfield_10016  # and its API id, to show effort in `ready --json`
# needs-info / risky / epic / deferred / question are plain Jira labels (created on first use).

# --- Beads only (the `br` CLI, beads_rust; a local store in <checkout>/.beads, run from the main checkout; nothing is committed) ---
# beads statuses are free-form: Todo=open, In Progress=in_progress, Done=closed are fixed; the other two can be renamed.
#BEADS_STATE_IN_REVIEW=in_review  # br status for the fleet state In Review (default in_review)
#BEADS_STATE_BACKLOG=backlog      # br status for Backlog (default backlog)
# Priorities: Urgent=P0 High=P1 Medium=P2 Low=P3 None=P4. Ids are br ids (proj-ab1, children proj-ab1.1).

# --- GitHub only: fit an existing repo's conventions (defaults: priority:* labels, no ready label) ---
#FLEET_GH_PRIORITY=field          # priority is the repo's native issue field instead of priority:* labels
#FLEET_GH_PRIORITY_FIELD=Priority # that field's name; options Urgent/High/Medium/Low
#FLEET_GH_EFFORT_FIELD=Effort     # an effort issue field, shown and settable with --effort (field mode)
#FLEET_READY_LABEL=ready-for-agent  # only items with this label are dispatchable
#FLEET_EXCLUDE_LABELS="needs-triage ready-for-human"  # more labels that keep an item out of the ready queue
#FLEET_ASSIGN_ON_CLAIM=1          # claiming an item assigns it to you, PRs are opened assigned to you

# --- Forge: where PRs/MRs and CI live ---
#FLEET_FORGE=github               # github | gitlab (an unknown value stops every script); gitlab reads host and
                                  # project from the origin remote, so a self-managed instance works too
#FLEET_INSTALL_UNTRACKED=0        # 1 = install.sh leaves nothing visible to git (team repos); unset: on for gitlab, off for github

# --- Wording (read with .claude/bin/fleet get; no script enforces them) ---
#FLEET_CHANGE_NOUN=PR             # PR | MR: what the agents call a change with the user (default: PR on github, MR on gitlab)
#FLEET_TITLE_FORMAT="{type}({scope}): {summary} ({ticket}) [AI-Assisted]"  # default empty (the workflow doc's "Commits"). Template of
                                  # the commit subject and the change title; {type} {scope} {summary} {ticket} (the item id)

# --- Change body check (fleet ship) ---
FLEET_SHIP_BODY_REQUIRE="What changes for you locally|Closes "  # default empty (no check). Lines the change body must contain, separated by "|" (e.g.
                                  # "What changes for you locally|Closes #"); fleet ship refuses before it pushes or opens
                                  # anything when the body file lacks one (match: case-insensitive, anywhere in the body)

# --- GitLab shipping (fleet ship; FLEET_FORGE=gitlab) ---
#FLEET_MR_DRAFT=1                 # 1: MRs open as drafts; 0: ready at once (ignored on github)
#FLEET_MR_ASSIGNEE=username       # assign new MRs to this user (default none)

# --- Verify (fleet ship --verify) ---
FLEET_VERIFY_CMD='scripts/gate-stamp.sh check "$FLEET_VERIFY_WORKTREE"'  # default empty (none). An extra project check, run by `bash -c` from the worktree with
                                  # FLEET_VERIFY_MR and FLEET_VERIFY_WORKTREE set; its first stdout line is added to the
                                  # verify line as check=<text>, a non-zero exit makes the verdict FAIL

# --- Catch-up (fleet catch-up) ---
FLEET_VALIDATE_CMD="just validate"  # default empty (none). Run by `bash -c` in each worktree fleet catch-up rebased; a non-zero
                                  # exit is exit 5 (the branch stays rebased, unpushed). fleet train runs it on the combined
                                  # tree of its changes and refuses to run without it

# --- Layout (defaults shown) ---
FLEET_DEFAULT_BRANCH=main        # default: origin/HEAD
FLEET_REPO=ceffo/critical            # project path; default: `gh repo view` (github) or the origin remote (gitlab)
#FLEET_WT_ROOT=/path/to/project.worktrees   # default: <checkout>.worktrees beside the checkout
#FLEET_SUPERVISOR_DIR=...         # state store (state.db), watcher pids (default: <wt root>/supervisor)

# --- The fleet itself: which fleet repo and channel this install follows (track this file; the installed fleet files are git-excluded) ---
#FLEET_UPSTREAM_URL=https://github.com/ceffo/agents-dev-fleet   # the fleet repo (default: this one); also where retro findings are filed; empty = file nowhere
#FLEET_REF=main                   # the channel (branch or tag) to follow: the pin is the channel, not a commit (default main)
#FLEET_UPDATE=auto                # auto | off: auto = the retiring supervisor at handoff, and an idle supervisor's ready-watch (about hourly, never under a live developer/reviewer/tester), update this install in place (fleet fleet-update); off = detect and report only (default auto)

# --- Upstream: where fleet-level retro findings are filed (fleet upstream-file; see docs/upstream.md) ---
#FLEET_UPSTREAM_OUTBOX=...        # requests that could not be filed wait here (default: <wt root>/upstream-outbox)

# --- CI the supervisor owns ---
#FLEET_CI_PROVIDER=github         # github | gitlab | none (default: follows FLEET_FORGE): none turns CI tracking off
#FLEET_CI_WORKFLOWS="CI"          # workflow names whose latest run on the default branch must be green (ignored on gitlab:
                                  # the default branch's latest pipeline is the one; there skipped = RED, canceled = superseded, and on an MR both are RED)
                                  # (space-separated; use ';' between names that contain spaces)
FLEET_RELEASE_WORKFLOW=Release   # a workflow a green CI push must trigger (e.g. Release); empty = none

# --- Supervisor ---
#FLEET_CONTEXT_LIMIT=150000       # context (tokens) past which the supervisor hands itself off
#FLEET_MAX_LANES=1                # most developers working at once (unset: one lane per independent item)
#FLEET_READY_POLL=300             # seconds between fleet ready-watch polls of the tracker's ready queue
#FLEET_LIAISON_POLL=30            # seconds between fleet liaison-watch polls of the calls to action (drives the liaison tab's blocked state)

# --- Merging ---
#FLEET_CLOSE_ON_MERGE=auto        # auto | 1 | 0: fleet close-merged moves the items a merged change's `Closes <id>` lines name to
                                  # Done. auto = only for trackers that don't close on merge themselves (beads, jira)
FLEET_MERGER=supervisor  # user | supervisor: who merges. user (default; what install.sh writes when nobody answers): the supervisor never
                                  # runs fleet land itself, it reports a green change as waiting on your merge, with its URL. supervisor: it merges
                                  # through fleet land (which still needs its allow rule in your Claude settings). fleet land's checks are the same either way. It governs what
                                  # the supervisor does by itself: arming fleet pr-merge-watch is your explicit request to merge those changes. An unknown value
                                  # prints one line and means user
FLEET_MERGE_METHOD=squash        # squash | merge | rebase: how fleet land merges; follow the repo's convention (merge = merge
                                  # commits). GitLab: squash or not; the project's merge method does the rest
#FLEET_REVIEW_BOT=""              # login regex of a review bot (e.g. "greptile|coderabbit"): fleet land refuses
                                  # a merge while one of its comment threads has no reply
#FLEET_MERGEABLE_POLLS=10         # fleet land re-reads a change whose mergeability is still UNKNOWN (GitHub computing it after
#FLEET_MERGEABLE_POLL_SECS=3      # the base moved; GitLab "checking") up to this many times, this many seconds apart;
                                  # still UNKNOWN after that is refused, never merged
                                  # integers; POLLS x SECS at most 90 (fleet land runs under a 2-minute Bash timeout)

# --- Post-merge done gate (fleet close-merged, fleet post-merge-watch) ---
#FLEET_POST_MERGE_CMD=""          # default empty (none: items are Done at the merge). A command that says whether a merged
                                  # change is really done (e.g. "./scripts/applied.sh"); run from the main checkout with the
                                  # change number and a sha (the change's merge commit, else the default branch's tip fetched when
                                  # the gate was armed: a commit that contains the merge) appended as arguments. Exit 0 = done (items move to Done), 10 = not yet
                                  # (polled again), anything else = failed (RED, the gate stops until `fleet post-merge-watch retry <n>`)
#FLEET_POST_MERGE_POLL=600        # seconds between two runs of that command for the same change (default 600)
#FLEET_POST_MERGE_TIMEOUT=900     # seconds one run of that command may take (default 900; 0 = no bound): past it the run is
                                  # killed and the change is RED ("timed out after <s>s")

# --- Agent start and prompt grace (fleet fleet-watch) ---
#FLEET_PROMPT_GRACE=30            # seconds after fleet agent-prompt during which a no-report turn end is held, not a
                                  # "NEEDS-SUPERVISOR ... turn ended" wake (default 30)
#FLEET_START_GRACE=300            # seconds after fleet agent-start, until the agent's first fleet agent-prompt, during which the
                                  # idle not-yet-prompted agent does not wake the supervisor (default 300)
#FLEET_WORK_GRACE=60             # seconds after fleet agent-prompt during which a turn end seen before the agent's first working
                                  # state since that prompt is held, not a wake (default 60)

# --- Agent names ---
#FLEET_NAME_PREFIX=""             # short project prefix of every agent name this fleet starts (<prefix>-sup-<n>, <prefix>-dev-<key>,
                                  # <prefix>-scoper-<subject>, ...), so several fleets under one herdr never collide (names are
                                  # global across workspaces). Default: the main checkout's folder name, lowercased. Set but empty:
                                  # no prefix. Agents already running keep their old names; both forms are recognised.

# --- Limited GitHub token for the sessions the fleet starts ---
#FLEET_GH_TOKEN_FILE=""           # default empty (off: sessions use the user's own gh login). Path of a file whose first line is a
                                  # (fine-grained, no-admin) GitHub token; fleet agent-start and fleet supervisor-handoff load it as
                                  # GH_TOKEN in every session they start. Set but missing/empty: the start is refused with one line.
                                  # The token never appears in args, logs or briefs (it goes through a 0600 settings file under
                                  # $FLEET_CONFIG_DIR). Keep the token file chmod 600, one per project
