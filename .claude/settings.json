{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR\"/.claude/bin/fleet; \"$f\" hook </dev/null >/dev/null 2>&1; [ $? = 1 ] || exit 1; exec \"$f\" hook no-cd-into-worktree"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR\"/.claude/bin/fleet; \"$f\" hook </dev/null >/dev/null 2>&1; [ $? = 1 ] || exit 1; exec \"$f\" hook supervisor-context-gauge"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR\"/.claude/bin/fleet; \"$f\" hook </dev/null >/dev/null 2>&1; [ $? = 1 ] || exit 1; exec \"$f\" hook supervisor-ci-guard",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
