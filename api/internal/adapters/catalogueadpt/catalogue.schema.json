{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ceffo/critical/schemas/catalogue.schema.json",
  "title": "Critical! catalogue, formats 3 and 4",
  "description": "Shape of the catalogue artifact (ADR 0021): format 3 holds the spells and the PHB rule tables (step 9); format 4 adds the class and race tables (step 10, ADR 0030 step 23). Shape only: the schema carries no book text. Format 1 (spells only) is retired and format 2 named a retracted shape: neither is valid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "spells",
    "rule_tables"
  ],
  "properties": {
    "format": {
      "description": "Artifact format: 3 (spells and rule_tables, ADR 0021 step 9) or 4 (format 3 plus the class and race tables, step 10). An importer accepts exactly the formats it knows and refuses the rest.",
      "enum": [
        3,
        4
      ]
    },
    "version": {
      "description": "Content version, UTC build date YYYY-MM-DD with an optional .N suffix for several builds on a day. Compared for equality only, never ordered.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(\\.[0-9]+)?$"
    },
    "spells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/spell"
      }
    },
    "rule_tables": {
      "$ref": "#/$defs/rule_tables"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "format": {
            "const": 4
          }
        }
      },
      "then": {
        "properties": {
          "rule_tables": {
            "required": [
              "experience",
              "hit_dice",
              "constitution",
              "intelligence",
              "wisdom",
              "con_save_bonus",
              "race_requirements",
              "race_adjustments",
              "thac0",
              "saving_throws",
              "warrior_attacks",
              "specialist_attacks",
              "rate_of_fire",
              "wizard_spells",
              "priest_spells",
              "priest_spell_wisdom",
              "thief_skill_base",
              "thief_skill_race",
              "thief_skill_dexterity",
              "thief_skill_armor",
              "bard_armor_penalty",
              "bard_skill_base",
              "backstab",
              "turning_undead"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "format": {
            "const": 3
          }
        }
      },
      "then": {
        "properties": {
          "rule_tables": {
            "properties": {
              "experience": false,
              "hit_dice": false,
              "constitution": false,
              "intelligence": false,
              "wisdom": false,
              "con_save_bonus": false,
              "race_requirements": false,
              "race_adjustments": false,
              "thac0": false,
              "saving_throws": false,
              "warrior_attacks": false,
              "specialist_attacks": false,
              "rate_of_fire": false,
              "wizard_spells": false,
              "priest_spells": false,
              "priest_spell_wisdom": false,
              "thief_skill_base": false,
              "thief_skill_race": false,
              "thief_skill_dexterity": false,
              "thief_skill_armor": false,
              "bard_armor_penalty": false,
              "bard_skill_base": false,
              "backstab": false,
              "turning_undead": false
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "localized": {
      "description": "English is required; French is optional and the app falls back to English when it is absent. An absent language is omitted, never an empty string.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "$ref": "#/$defs/text"
        },
        "fr": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "description": {
      "description": "Text in the Markdown subset of ADR 0021 step 1: blocks separated by exactly one blank line; a block is a paragraph (one line, no hard wrap), a bullet list (lines starting with \"- \") or a pipe table (lines starting and ending with \"|\"); no headings, no HTML, no leading or trailing whitespace. The pattern checks the block structure; the builder also checks table delimiter rows.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "$ref": "#/$defs/paragraphs"
        },
        "fr": {
          "$ref": "#/$defs/paragraphs"
        }
      }
    },
    "paragraphs": {
      "description": "One description in one language.",
      "type": "string",
      "pattern": "^(?:(?:[^\\s|#-](?:[^\\n]*\\S)?|-\\S(?:[^\\n]*\\S)?)|- \\S(?:[^\\n]*\\S)?(?:\\n- \\S(?:[^\\n]*\\S)?)*|\\|[^\\n]*\\|(?:\\n\\|[^\\n]*\\|)*)(?:\\n\\n(?:(?:[^\\s|#-](?:[^\\n]*\\S)?|-\\S(?:[^\\n]*\\S)?)|- \\S(?:[^\\n]*\\S)?(?:\\n- \\S(?:[^\\n]*\\S)?)*|\\|[^\\n]*\\|(?:\\n\\|[^\\n]*\\|)*))*$"
    },
    "spell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "level",
        "school",
        "casting_time",
        "range",
        "duration",
        "area_of_effect",
        "components",
        "saving_throw",
        "name",
        "description",
        "source"
      ],
      "properties": {
        "id": {
          "description": "Stable key, never changes once published (spellbook, spell effects, slots and undo history reference it). The builder keeps it in a published-id ledger (ADR 0021 step 3).",
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "class": {
          "enum": [
            "Wizard",
            "Priest"
          ]
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "school": {
          "description": "Raw school text as the book prints it; may hold several, e.g. \"Alteration, Evocation\".",
          "$ref": "#/$defs/text"
        },
        "sphere": {
          "description": "Priest spells only (raw text, may hold several spheres). Omitted for Wizard spells.",
          "$ref": "#/$defs/text"
        },
        "casting_time": {
          "$ref": "#/$defs/text"
        },
        "range": {
          "$ref": "#/$defs/text"
        },
        "duration": {
          "$ref": "#/$defs/text"
        },
        "area_of_effect": {
          "$ref": "#/$defs/text"
        },
        "components": {
          "$ref": "#/$defs/text"
        },
        "saving_throw": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/localized"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "source": {
          "description": "Provenance of the English text, 2 to 8 upper-case characters: a book code (PHB, TOM) or WEB for text of the original web scrape that no book has been matched to.",
          "type": "string",
          "pattern": "^[A-Z0-9]{2,8}$"
        }
      }
    },
    "rule_tables": {
      "description": "The rule tables the engine looks values up in (ADR 0021 steps 9 and 10): numbers and language-neutral codes only, the columns the engine reads, rows in ascending order. Format 3 carries the first four tables only, format 4 every table. Contiguity, overlap, level order, increasing XP and completeness of the code combinations cannot be expressed here: the builder and the importer check them.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strength",
        "dexterity",
        "bard_spells",
        "bard_experience"
      ],
      "properties": {
        "strength": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/strength_row"
          }
        },
        "dexterity": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dexterity_row"
          }
        },
        "bard_spells": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/bard_spells_row"
          }
        },
        "bard_experience": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/bard_experience_row"
          }
        },
        "experience": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/experience_row"
          }
        },
        "hit_dice": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/hit_dice_row"
          }
        },
        "constitution": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/constitution_row"
          }
        },
        "intelligence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/intelligence_row"
          }
        },
        "wisdom": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/wisdom_row"
          }
        },
        "con_save_bonus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/con_save_bonus_row"
          }
        },
        "race_requirements": {
          "type": "array",
          "minItems": 30,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/race_requirement_row"
          }
        },
        "race_adjustments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/race_adjustment_row"
          }
        },
        "thac0": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/thac0_row"
          }
        },
        "saving_throws": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/saving_throw_row"
          }
        },
        "warrior_attacks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/level_rate_row"
          }
        },
        "specialist_attacks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/specialist_attack_row"
          }
        },
        "rate_of_fire": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rate_of_fire_row"
          }
        },
        "wizard_spells": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/wizard_spells_row"
          }
        },
        "priest_spells": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/priest_spells_row"
          }
        },
        "priest_spell_wisdom": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/priest_spell_wisdom_row"
          }
        },
        "thief_skill_base": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/skill_base_row"
          }
        },
        "thief_skill_race": {
          "type": "array",
          "minItems": 40,
          "maxItems": 40,
          "items": {
            "$ref": "#/$defs/skill_race_row"
          }
        },
        "thief_skill_dexterity": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/skill_dexterity_row"
          }
        },
        "thief_skill_armor": {
          "type": "array",
          "minItems": 24,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/skill_armor_row"
          }
        },
        "bard_armor_penalty": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/bard_armor_penalty_row"
          }
        },
        "bard_skill_base": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/skill_base_row"
          }
        },
        "backstab": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/backstab_row"
          }
        },
        "turning_undead": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": {
            "$ref": "#/$defs/turning_row"
          }
        }
      }
    },
    "strength_row": {
      "description": "PHB Table 1: a range of Strength scores, and for 18 a range of the 18/xx percentile.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "str_min",
        "str_max",
        "exc_min",
        "exc_max",
        "hit",
        "dmg"
      ],
      "properties": {
        "str_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "str_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "exc_min": {
          "description": "18/xx percentile, 100 = 18/00; 0 with exc_max 0 = no exceptional part.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "exc_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "hit": {
          "description": "Hit probability adjustment.",
          "type": "integer"
        },
        "dmg": {
          "description": "Damage adjustment.",
          "type": "integer"
        }
      }
    },
    "dexterity_row": {
      "description": "PHB Table 2: a range of Dexterity scores.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dex_min",
        "dex_max",
        "reaction",
        "missile",
        "defensive"
      ],
      "properties": {
        "dex_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "dex_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "reaction": {
          "description": "Reaction adjustment.",
          "type": "integer"
        },
        "missile": {
          "description": "Missile attack adjustment.",
          "type": "integer"
        },
        "defensive": {
          "description": "Defensive adjustment to AC (negative improves it).",
          "type": "integer"
        }
      }
    },
    "bard_spells_row": {
      "description": "PHB Table 32: the spells a bard of that level casts per day.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "per_spell_level"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "per_spell_level": {
          "description": "Spells per day of spell levels 1 to 6.",
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "bard_experience_row": {
      "description": "PHB Table 25, Thief/Bard column: the XP that reaches the level.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "xp"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "experience_row": {
      "description": "PHB Tables 14 (Fighter), 20 (Mage), 23 (Cleric), 25 (Thief/Bard): the XP that reaches the level, per class.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "fighter",
        "mage",
        "cleric",
        "thief",
        "bard"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "fighter": {
          "type": "integer",
          "minimum": 0
        },
        "mage": {
          "type": "integer",
          "minimum": 0
        },
        "cleric": {
          "type": "integer",
          "minimum": 0
        },
        "thief": {
          "type": "integer",
          "minimum": 0
        },
        "bard": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "hit_dice_row": {
      "description": "PHB Tables 14, 20, 23, 25 (Hit Dice column): the group's hit die, the last level that rolls it, and the fixed hit points gained per level after it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "die",
        "name_level",
        "gain_after"
      ],
      "properties": {
        "group": {
          "enum": [
            "warrior",
            "priest",
            "rogue",
            "wizard"
          ]
        },
        "die": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20
        },
        "name_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "gain_after": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "constitution_row": {
      "description": "PHB Table 3: hit point adjustment per die (every class, and the warriors' own), and the value a low die counts as (0 = none).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "con_min",
        "con_max",
        "hp",
        "hp_warrior",
        "low_die_min"
      ],
      "properties": {
        "con_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "con_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "hp": {
          "type": "integer"
        },
        "hp_warrior": {
          "type": "integer"
        },
        "low_die_min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "intelligence_row": {
      "description": "PHB Table 4: highest spell level (0 = none), chance to learn a spell in percent, maximum spells per level (absent = no maximum).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "int_min",
        "int_max",
        "max_spell_level",
        "learn_chance"
      ],
      "properties": {
        "int_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "int_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "max_spell_level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "learn_chance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "max_spells": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "wisdom_row": {
      "description": "PHB Table 5: the bonus spells this score adds (spell levels, not cumulative) and the chance of spell failure in percent.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wis_min",
        "wis_max",
        "bonus_spells",
        "spell_failure"
      ],
      "properties": {
        "wis_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "wis_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "bonus_spells": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        },
        "spell_failure": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "con_save_bonus_row": {
      "description": "PHB Table 9: saving throw bonus by Constitution.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "con_min",
        "con_max",
        "bonus"
      ],
      "properties": {
        "con_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "con_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "bonus": {
          "type": "integer"
        }
      }
    },
    "race_requirement_row": {
      "description": "PHB Table 7: the score range a race allows for an ability (before the racial adjustments).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "race",
        "ability",
        "min",
        "max"
      ],
      "properties": {
        "race": {
          "enum": [
            "dwarf",
            "elf",
            "gnome",
            "half_elf",
            "halfling"
          ]
        },
        "ability": {
          "enum": [
            "str",
            "dex",
            "con",
            "int",
            "wis",
            "cha"
          ]
        },
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        }
      }
    },
    "race_adjustment_row": {
      "description": "PHB Table 8: a race's ability adjustment (abilities not listed: 0).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "race",
        "ability",
        "adjustment"
      ],
      "properties": {
        "race": {
          "enum": [
            "dwarf",
            "elf",
            "gnome",
            "half_elf",
            "halfling"
          ]
        },
        "ability": {
          "enum": [
            "str",
            "dex",
            "con",
            "int",
            "wis",
            "cha"
          ]
        },
        "adjustment": {
          "type": "integer"
        }
      }
    },
    "thac0_row": {
      "description": "PHB Table 53: THAC0 per group at the level.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "warrior",
        "priest",
        "rogue",
        "wizard"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "warrior": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "priest": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "rogue": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "wizard": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "saving_throw_row": {
      "description": "PHB Table 60: the five save targets of a group over a level band (levels 1 to 20).",
      "type": "object",
