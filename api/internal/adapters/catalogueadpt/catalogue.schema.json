{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ceffo/critical/schemas/catalogue.schema.json",
  "title": "Critical! catalogue, format 3",
  "description": "Shape of the catalogue artifact (ADR 0021): format 3 holds the spells and the PHB rule tables (step 9). Shape only: the schema carries no book text. Format 1 (spells only) is retired and format 2 named a retracted shape: neither is valid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "spells",
    "rule_tables"
  ],
  "properties": {
    "format": {
      "description": "Artifact format: 3 (spells and rule_tables, ADR 0021 step 9). An importer accepts exactly the formats it knows and refuses the rest.",
      "const": 3
    },
    "version": {
      "description": "Content version, UTC build date YYYY-MM-DD with an optional .N suffix for several builds on a day. Compared for equality only, never ordered.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(\\.[0-9]+)?$"
    },
    "spells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/spell"
      }
    },
    "rule_tables": {
      "$ref": "#/$defs/rule_tables"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "localized": {
      "description": "English is required; French is optional and the app falls back to English when it is absent. An absent language is omitted, never an empty string.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "$ref": "#/$defs/text"
        },
        "fr": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "description": {
      "description": "Text in the Markdown subset of ADR 0021 step 1: blocks separated by exactly one blank line; a block is a paragraph (one line, no hard wrap), a bullet list (lines starting with \"- \") or a pipe table (lines starting and ending with \"|\"); no headings, no HTML, no leading or trailing whitespace. The pattern checks the block structure; the builder also checks table delimiter rows.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en"
      ],
      "properties": {
        "en": {
          "$ref": "#/$defs/paragraphs"
        },
        "fr": {
          "$ref": "#/$defs/paragraphs"
        }
      }
    },
    "paragraphs": {
      "description": "One description in one language.",
      "type": "string",
      "pattern": "^(?:(?:[^\\s|#-](?:[^\\n]*\\S)?|-\\S(?:[^\\n]*\\S)?)|- \\S(?:[^\\n]*\\S)?(?:\\n- \\S(?:[^\\n]*\\S)?)*|\\|[^\\n]*\\|(?:\\n\\|[^\\n]*\\|)*)(?:\\n\\n(?:(?:[^\\s|#-](?:[^\\n]*\\S)?|-\\S(?:[^\\n]*\\S)?)|- \\S(?:[^\\n]*\\S)?(?:\\n- \\S(?:[^\\n]*\\S)?)*|\\|[^\\n]*\\|(?:\\n\\|[^\\n]*\\|)*))*$"
    },
    "spell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "class",
        "level",
        "school",
        "casting_time",
        "range",
        "duration",
        "area_of_effect",
        "components",
        "saving_throw",
        "name",
        "description",
        "source"
      ],
      "properties": {
        "id": {
          "description": "Stable key, never changes once published (spellbook, spell effects, slots and undo history reference it). The builder keeps it in a published-id ledger (ADR 0021 step 3).",
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "class": {
          "enum": [
            "Wizard",
            "Priest"
          ]
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "school": {
          "description": "Raw school text as the book prints it; may hold several, e.g. \"Alteration, Evocation\".",
          "$ref": "#/$defs/text"
        },
        "sphere": {
          "description": "Priest spells only (raw text, may hold several spheres). Omitted for Wizard spells.",
          "$ref": "#/$defs/text"
        },
        "casting_time": {
          "$ref": "#/$defs/text"
        },
        "range": {
          "$ref": "#/$defs/text"
        },
        "duration": {
          "$ref": "#/$defs/text"
        },
        "area_of_effect": {
          "$ref": "#/$defs/text"
        },
        "components": {
          "$ref": "#/$defs/text"
        },
        "saving_throw": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/localized"
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "source": {
          "description": "Provenance of the English text, 2 to 8 upper-case characters: a book code (PHB, TOM) or WEB for text of the original web scrape that no book has been matched to.",
          "type": "string",
          "pattern": "^[A-Z0-9]{2,8}$"
        }
      }
    },
    "rule_tables": {
      "description": "The PHB rule tables the engine looks values up in (ADR 0021 step 9): numbers only, the columns the engine reads, rows in ascending order. Contiguity, overlap, level order and increasing XP cannot be expressed here: the builder and the importer check them.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strength",
        "dexterity",
        "bard_spells",
        "bard_experience"
      ],
      "properties": {
        "strength": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/strength_row"
          }
        },
        "dexterity": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dexterity_row"
          }
        },
        "bard_spells": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/bard_spells_row"
          }
        },
        "bard_experience": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/bard_experience_row"
          }
        }
      }
    },
    "strength_row": {
      "description": "PHB Table 1: a range of Strength scores, and for 18 a range of the 18/xx percentile.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "str_min",
        "str_max",
        "exc_min",
        "exc_max",
        "hit",
        "dmg"
      ],
      "properties": {
        "str_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "str_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "exc_min": {
          "description": "18/xx percentile, 100 = 18/00; 0 with exc_max 0 = no exceptional part.",
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "exc_max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "hit": {
          "description": "Hit probability adjustment.",
          "type": "integer"
        },
        "dmg": {
          "description": "Damage adjustment.",
          "type": "integer"
        }
      }
    },
    "dexterity_row": {
      "description": "PHB Table 2: a range of Dexterity scores.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dex_min",
        "dex_max",
        "reaction",
        "missile",
        "defensive"
      ],
      "properties": {
        "dex_min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "dex_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "reaction": {
          "description": "Reaction adjustment.",
          "type": "integer"
        },
        "missile": {
          "description": "Missile attack adjustment.",
          "type": "integer"
        },
        "defensive": {
          "description": "Defensive adjustment to AC (negative improves it).",
          "type": "integer"
        }
      }
    },
    "bard_spells_row": {
      "description": "PHB Table 32: the spells a bard of that level casts per day.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "per_spell_level"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "per_spell_level": {
          "description": "Spells per day of spell levels 1 to 6.",
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "bard_experience_row": {
      "description": "PHB Table 25, Thief/Bard column: the XP that reaches the level.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "xp"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "xp": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
