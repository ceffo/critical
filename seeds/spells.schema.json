{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AD&D 2nd Edition Spell",
  "description": "Schema for seeds/spells.json — sourced from vodabois.fi/2eSpells (WizardSpells.json + PriestSpells.json)",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "class", "level", "school", "casting_time", "range", "duration", "area_of_effect"],
    "properties": {
      "name":           { "type": "string", "description": "Spell name" },
      "class":          { "type": "string", "enum": ["Wizard", "Priest"], "description": "Spell class" },
      "level":          { "type": "integer", "minimum": 1, "maximum": 9, "description": "Spell level" },
      "school":         { "type": "string", "description": "School of magic (e.g. Evocation, Divination)" },
      "sphere":         { "type": "string", "description": "Priest sphere(s); empty string for Wizard spells" },
      "casting_time":   { "type": "string", "description": "Casting time (e.g. '1', '1 rd.', '1 turn')" },
      "range":          { "type": "string", "description": "Spell range (e.g. '60 yds. + 10 yds./level')" },
      "duration":       { "type": "string", "description": "Spell duration (e.g. '1 rd./level', 'Permanent')" },
      "area_of_effect": { "type": "string", "description": "Area of effect (e.g. 'One creature', '10-ft. radius')" },
      "components":     { "type": "string", "description": "Required components (V, S, M)" },
      "saving_throw":   { "type": "string", "description": "Saving throw type (e.g. 'None', 'Neg.', '1/2')" },
      "description":    { "type": "string", "description": "Full spell description from source material" }
    }
  }
}
